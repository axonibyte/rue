<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The .NET embedding SDK for rue's hook protocol (docs/ROADMAP.md 7.11).

    No framework dependency and no package dependency: System.Text.Json is
    part of the platform, so a host application takes on nothing it did not
    already have.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>Rue.Hook</PackageId>
    <Version>0.1.0</Version>
    <Description>A conformance-tested client of rue's hook protocol (docs/hook-protocol.md v1).</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
