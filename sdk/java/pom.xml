<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Java embedding SDK for rue's hook protocol (docs/ROADMAP.md 7.11).

  No framework dependency and no runtime dependency at all: the JDK ships
  no JSON, so this carries a small codec of its own rather than obliging
  every host application to adopt Jackson or Gson. A hook is a line of JSON
  in and a line of JSON out; that is not worth a framework.

  JUnit is here in test scope only. Test scope is neither packaged nor
  transitive, so a host that depends on this artifact receives nothing but
  these classes, and JUnit's EPL-2.0 reaches nobody who uses them.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.rue</groupId>
  <artifactId>rue-hook</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>
  <name>rue-hook</name>
  <description>A conformance-tested client of rue's hook protocol (docs/hook-protocol.md v1).</description>
  <licenses>
    <license>
      <name>BSD-2-Clause</name>
      <url>https://opensource.org/license/bsd-2-clause</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- Pinned, as every tool this project runs is: maven's own defaults
           for these move with maven's version, and the pipeline's image and
           the reaper guest's package would otherwise build differently. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
    </plugins>
  </build>
</project>
