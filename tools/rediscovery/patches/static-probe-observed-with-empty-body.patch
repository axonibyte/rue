             .map(|p| p.name.clone())
             .collect();
         for probe in statics {
-            let value = match self.observe_raw(rec, &owner, &probe) {
+            let empty = crate::executor::ProbeRun {
+                name: probe.clone(),
+                body: Vec::new(),
+            };
+            let value = match self
+                .executor_index(&owner)
+                .ok_or_else(|| "no executor".to_string())
+                .and_then(|i| self.executors[i].observe(&owner, &empty).map_err(|e| e.to_string()))
