rue 0
# Negative case E0506: permanent plan's step gate with no window and no site max_wait
# Derived from T3 (tenants/t3/plan.rue) by one change. The checker must refuse
# with exactly E0506; expected/ holds the refusing verdict.

import "../../t3/plan.rue" as t3

defplan :open_mgmt_port, %{os: :freebsd} do
  backstop trigger: [unless_confirmed: 10m], locus: :target, arm_before: 1
  t3.pf_allow(port: 8443), gate: auth(:netops)   # no window:, and T3's site has no max_wait
  observe t3.verify_reach() as reach
  confirm()
  commit()
end
