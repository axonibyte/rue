rue 0
# Negative case E0101: a parse error. The step's call is never closed; the
# parser reports it, recovers at the next line, and the rest still parses.
# A minimal plan on the lab site. The front end must refuse with exactly E0101.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  backstop scheduler: cron()
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

defop :posture, _ do
  footprint owned: file("/etc/a")
  do: write(file("/etc/a"), content: "x")
  undo: :restore
end

defplan :posture, %{name: "db-01"} do
  wane 1h
  posture(
end
