rue 0
# Negative case E0602: a binding without the argument its contract asks:
# a journal file with no path. The front end must refuse with exactly E0602.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: file()
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

defop :posture, _ do
  footprint owned: file("/etc/a")
  do: write(file("/etc/a"), content: "x")
  undo: :restore
end

defplan :posture, %{name: "db-01"} do
  wane 1h
  posture()
end
