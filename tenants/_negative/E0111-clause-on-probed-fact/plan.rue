rue 0
# Negative case E0111: a clause pattern names a fact that is not part of the
# host contract (name, os, address, roles, reach). The front end must refuse
# with exactly E0111.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  backstop scheduler: cron()
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

defop :posture, %{load: :high} do
  footprint owned: file("/etc/a")
  do: write(file("/etc/a"), content: "x")
  undo: :restore
end

defplan :posture, %{name: "db-01"} do
  wane 1h
  posture()
end
