rue 0
# Negative case E0410: reach op whose undo is drift :defer
# Derived from T3 (tenants/t3/plan.rue) by one change. The checker must refuse
# with exactly E0410; expected/ holds the refusing verdict.

import "../../t3/plan.rue" as t3

defop :pf_allow, %{os: :freebsd} do
  footprint modified: file("/etc/pf.conf")   # modified defaults to drift: :defer
  reach ssh(host)
  do: run("pfctl -f /etc/pf.conf")
  undo: :restore
  undo_locus: :target
end

defplan :open_mgmt_port, %{os: :freebsd} do
  backstop trigger: [unless_confirmed: 10m], locus: :target, arm_before: 1
  pf_allow(port: 8443)
  observe t3.verify_reach() as reach
  confirm()
  commit()
end
