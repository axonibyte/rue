rue 0
# Negative case E0508: plan-entry gate that counts the requester
# Derived from T1 (tenants/t1/plan.rue) by one change. The checker must refuse
# with exactly E0508; expected/ holds the refusing verdict.

import "../../t1/plan.rue" as t1

# T1's site with one more authenticator: the requester, declared human in
# this directory's inventory.toml; the plan's gate then names it.
site do
  inventory from: file("inventory.toml")
  journal to: local()
  approval via: hook(:authority)
  secrets deliver_to: [requester(), hook(:escrow)]
  execute via: [ssh(identity: "keys/id_ed25519", known_hosts: "known_hosts", user: "root"), hook(:bmc_api, transport: :api)]
  backstop scheduler: cron()
  operators do
    identity :ops_requester, user: "ops", operator_for: :all, admin: true
  end
  hooks do
    registrar :authority, user: "approvald", may_register: [:authority, :escrow, :bmc_api]
  end
end

defplan :breakglass, %{name: "db-01"} do
  gate auth(:requester), window: 30m
  wane 4h, renew_within: 30m
  backstop trigger: [after: 4h, unless_heartbeat: 60s, interval: 20s], locus: :target, arm_before: 3
  exclusivity: :breakglass
  t1.service_posture(posture: "PermitRootLogin yes")
  t1.authorized_keys_block(keys: requester_key)
  t1.bmc_account_enable() as bmc
  t1.console_tunnel()
end
