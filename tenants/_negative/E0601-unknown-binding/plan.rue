rue 0
# Negative case E0601: a binding kind no site line admits.
# The front end must refuse with exactly E0601.

site do
  inventory from: ldap("ou=hosts")
  journal to: local()
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

defop :posture, _ do
  footprint owned: file("/etc/a")
  do: write(file("/etc/a"), content: "x")
  undo: :restore
end

defplan :posture, %{name: "db-01"} do
  wane 1h
  posture()
end
