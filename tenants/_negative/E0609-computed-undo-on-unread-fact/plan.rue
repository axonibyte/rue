rue 0
# Negative case E0609: a computed undo on a fact the host's executor cannot
# read. db-01 is reached by ssh(), which reads files alone; the worker's
# running state is no file, and no probe says it reads it. A failed start
# could not show it never took, so its undo -- a stop by name -- would stop
# a worker the plan never started, and drift on it would never be seen. The
# checker must refuse with exactly E0609.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  backstop scheduler: cron()
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

defop :start_worker, _ do
  footprint modified: service.state("worker")
  do: run("service worker onestart")
  undo: run("service worker onestop", idempotent: true)
  undo_pre service.state("worker")
  undo_locus: :controller
end

defplan :worker, %{name: "db-01"} do
  wane 1h
  start_worker()
end
