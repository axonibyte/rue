rue 0
# Negative case E0113: a repeat over a list with a repeated member is not
# set-valued. The front end must refuse with exactly E0113.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  backstop scheduler: cron()
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

defop :posture, _ do
  footprint owned: file("/etc/a")
  do: write(file("/etc/a"), content: "x")
  undo: :restore
end

defplan :posture, %{name: "db-01"} do
  wane 1h
  repeat over: [:a, :b, :a], as g, max: 3 do
    posture()
  end
end
