rue 0
# Negative case E0210: secret referenced from a :target undo body
# A minimal plan on the lab site (tenants/harness/src/tenants/negative.rs,
# `lab`). The checker must refuse with exactly E0210.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  backstop scheduler: cron()
  secrets from: file("secrets.toml")
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

defop :posture, _ do
  footprint owned: file("/etc/a")
  do: write(file("/etc/a"), content: "x")
  undo: run("db-restore /etc/a", stdin: secret(:db_pw), idempotent: true)   # on stdin, so that E0209 does not also fire
  undo_pre file("/etc/a")
  undo_locus: :target
end

defplan :posture, %{name: "db-01"} do
  wane 1h
  posture()
end
