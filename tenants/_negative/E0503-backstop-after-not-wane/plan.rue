rue 0
# Negative case E0503: temporary plan whose backstop after: differs from its wane
# A minimal plan on the lab site (tenants/harness/src/tenants/negative.rs,
# `lab`). The checker must refuse with exactly E0503.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  backstop scheduler: cron()
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

defop :posture, _ do
  footprint owned: file("/etc/a")
  do: write(file("/etc/a"), content: "x")
  undo: :restore
  undo_locus: :target
end

defplan :posture, %{name: "db-01"} do
  wane 1h
  backstop trigger: [after: 2h], locus: :target, arm_before: 1
  posture()
end
