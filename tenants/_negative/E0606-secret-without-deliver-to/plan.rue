rue 0
# Negative case E0606: plan has a secret output and the site declares no secrets deliver_to
# A minimal plan on the lab site (tenants/harness/src/tenants/negative.rs,
# `lab`). The checker must refuse with exactly E0606.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  # A hook for the controller, so the case's hook action has something to
  # perform it and the case is wrong only in the way it is named for; with
  # local() alone this was also E0608.
  execute via: [ssh(identity: "keys/id_ed25519", known_hosts: "known_hosts", user: "root"), hook(:token_api, transport: :controller)]
  backstop scheduler: cron()
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
  hooks do
    registrar :requester, user: "ops", may_register: [:token_api]
  end
end

defop :issue_token, _ do
  footprint modified: api.token
  do: hook(:issue_token)
  undo: hook(:revoke_token, idempotent: true)
  undo_pre api.token
  outputs token, secret: true   # and the site above names no acceptor
  locus: :controller
end

defplan :token, %{name: "db-01"} do
  wane 1h
  issue_token()
end
