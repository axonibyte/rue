rue 0
# Negative case E0211: secret env:/stdin: on an executor that cannot honor the stdin preamble
# A minimal plan on the lab site (tenants/harness/src/tenants/negative.rs,
# `lab`). The checker must refuse with exactly E0211.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  backstop scheduler: cron()
  secrets from: file("secrets.toml")
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

# api-01 is an appliance behind an API executor; nothing there reads a
# preamble, so env:/stdin: have no carrier.
defop :bmc_login, %{os: :appliance} do
  footprint modified: bmc.session
  do: run("bmc login", env: %{BMC_PW: {:secret, :bmc_pw}})
  undo: :restore
  locus: host("api-01")
end

defplan :bmc_login, %{name: "db-01"} do
  wane 1h
  bmc_login()
end
