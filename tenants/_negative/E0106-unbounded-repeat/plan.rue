rue 0
# Negative case E0106: a non-total construct, the repeat over a fact with no
# literal cap. The front end must refuse with exactly E0106.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  backstop scheduler: cron()
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

defop :posture, _ do
  footprint owned: file("/etc/a")
  do: write(file("/etc/a"), content: "x")
  undo: :restore
end

defplan :posture, %{name: "db-01"} do
  wane 1h
  repeat over: guests, as g do
    posture()
  end
end
