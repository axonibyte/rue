rue 0
# Negative case E0209: secret interpolated into a run string
# A minimal plan on the lab site (tenants/harness/src/tenants/negative.rs,
# `lab`). The checker must refuse with exactly E0209.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  backstop scheduler: cron()
  secrets from: file("secrets.toml")
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

defop :posture, _ do
  footprint owned: file("/etc/a")
  do: run("curl -u admin:#{secret(:db_pw)} https://db/posture")   # a secret in shell text
end

defplan :posture, %{name: "db-01"} do
  wane 1h
  posture()
end
