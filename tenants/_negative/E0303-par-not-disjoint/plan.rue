rue 0
# Negative case E0303: par children whose umbras overlap
# A minimal plan on the lab site (proto/tenants/Rue/Proto/Tenants/Negative.hs,
# `lab`). The checker must refuse with exactly E0303.

site do
  inventory from: file("../lab-inventory.toml")
  journal to: local()
  backstop scheduler: cron()
  operators do
    identity :requester, user: "ops", operator_for: :all, admin: true
  end
end

defop :posture, _ do
  footprint owned: file("/etc/a")
  do: write(file("/etc/a"), content: "x")
  undo: :restore
end

defplan :par, %{name: "db-01"} do
  wane 1h
  par do
    posture()
    posture()
  end
end
